# Converts GLSL files into a C++ header with one string constant per file.
#   cmake -DOUTPUT=<header> -DINPUTS=<a.vs;b.fs;...> -P EmbedShaders.cmake
# "chunk.vs" becomes `voxelforge::shaders::kChunkVs`.

if(NOT OUTPUT OR NOT INPUTS)
    message(FATAL_ERROR "EmbedShaders.cmake requires OUTPUT and INPUTS")
endif()

set(content "// Generated by cmake/EmbedShaders.cmake - do not edit.\n#pragma once\n\nnamespace voxelforge::shaders {\n")

foreach(input IN LISTS INPUTS)
    get_filename_component(name "${input}" NAME_WE)
    get_filename_component(ext "${input}" EXT)
    string(SUBSTRING "${ext}" 1 -1 ext)
    string(SUBSTRING "${name}" 0 1 first)
    string(TOUPPER "${first}" first)
    string(SUBSTRING "${name}" 1 -1 rest)
    string(SUBSTRING "${ext}" 0 1 extFirst)
    string(TOUPPER "${extFirst}" extFirst)
    string(SUBSTRING "${ext}" 1 -1 extRest)
    set(symbol "k${first}${rest}${extFirst}${extRest}")

    file(READ "${input}" source)
    string(FIND "${source}" ")GLSL\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR "${input} contains the raw string delimiter )GLSL\"")
    endif()
    string(APPEND content "\ninline constexpr const char* ${symbol} = R\"GLSL(${source})GLSL\";\n")
endforeach()

string(APPEND content "\n} // namespace voxelforge::shaders\n")

# Only touch the file when it changes to avoid needless rebuilds.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
